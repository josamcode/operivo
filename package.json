{
  "name": "opervio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @opervio/server --filter @opervio/web run dev",
    "build": "pnpm --filter @opervio/web run build",
    "start": "pnpm --filter @opervio/server run start",
    "app": "pnpm build && pnpm start",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "e2e": "pnpm --filter @opervio/web run e2e",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @opervio/server run db:deploy"
  }
}
